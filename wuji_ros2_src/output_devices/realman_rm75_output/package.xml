<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>realman_rm75_output</name>
  <version>0.1.0</version>
  <description>Safe dry-run PICO relative-pose mapper for RealMan RM75</description>
  <maintainer email="support@wuji.tech">Wuji Tech</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- Pinocchio is installed as the pinned `pin` wheel in docker/Dockerfile. -->
  <exec_depend>rm_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
