# Portable defaults for the Wuji FTP-1 acquisition stack.
# Paths are resolved relative to the project root unless they start with '/'.

WUJI_ROS_DISTRO=humble
WUJI_DATA_DIR=data/ftp1
WUJI_RUNTIME_DIR=.runtime
WUJI_PYTHON=.venv/bin/python
WUJI_GLOVE_SN=
WUJI_TACTILE_HEALTH_MASK=
WUJI_JOINT_PREFLIGHT_SECONDS=2.0
WUJI_JOINT_PREFLIGHT_MIN_RANGE_DEG=3.0
WUJI_MYO_START_WAIT_S=20
WUJI_WAVLETECH_START_WAIT_S=20

# Optional L20/G20 SDK is vendored under drivers/ for portable bundles.
WUJI_L20_DRIVER_WS=drivers/linker_hand_ros2_sdk
WUJI_L20_DATA_DIR=data/l20

# First-person RealSense RGB.
WUJI_EGO_PROFILE=960x540x60
WUJI_EGO_EXPOSURE_US=2500
WUJI_EGO_GAIN=16
WUJI_EGO_TOPIC=/camera/camera/color/image_raw

# Human-mode first-person PICO passthrough. Android screenrecord follows the
# headset display refresh; this A9210 produces about 90 genuine frames/s at
# 1920x960 stereo. One eye is cropped to the policy ROI below and saved as ego RGB.
WUJI_VR_EGO_ENABLED=1
WUJI_VR_EGO_MODE=raw
# PICO headset IPv4 on the collection LAN. Raw mode uses the app's existing
# Tracker UI and native CameraHandle stream; no display capture or ROI is used.
WUJI_VR_EGO_PICO_IP=auto
WUJI_VR_EGO_RAW_CONTROL_PORT=13579
# This PICO CameraHandle build ignores a random callback port and reliably
# reconnects to the fixed port used by the native client.
WUJI_VR_EGO_RAW_STREAM_PORT=50081
# Native PICO4U stereo profile, two 1080x810 eyes. This is the supported
# CameraHandle profile; the collector keeps the compressed side-by-side frame.
WUJI_VR_EGO_RAW_SIZE=2160x810
WUJI_VR_EGO_RAW_FPS=60
WUJI_VR_EGO_RAW_BITRATE=20000000
WUJI_VR_EGO_RAW_CALLBACK_IP=auto
WUJI_VR_EGO_RAW_JPEG_QUALITY=85
# A deep queue hid a slightly slow publisher as ~1.5 s of stale video. Keep
# only a short scheduling cushion; the publisher reports/drops stale frames.
WUJI_VR_EGO_RAW_QUEUE_DEPTH=6
WUJI_VR_EGO_RVIZ_ENABLED=0
WUJI_VR_EGO_RAW_FRAME_ID=pico_vst_optical_frame
# Empty means auto-select the only authorized device shown by `adb devices`.
WUJI_VR_EGO_ADB_SERIAL=
WUJI_VR_EGO_TOPIC=/pico/ego/image_raw/compressed
WUJI_VR_EGO_SCREEN_SIZE=1920x960
WUJI_VR_EGO_OUTPUT_SIZE=native
# screenrecord is a composited display diagnostic source, not raw camera data.
# Use a native PICO Camera API app for policy RGB; keep this ROI only for testing.
WUJI_VR_EGO_POLICY_ROI=60,60,840,840
WUJI_VR_EGO_BIT_RATE=24M
WUJI_VR_EGO_EYE=both
# q:v 6 keeps the policy ROI geometry while reducing DDS payload and
# JPEG CPU; the paced publisher selects genuine frames for stable 60 FPS.
WUJI_VR_EGO_JPEG_QUALITY=6
WUJI_VR_EGO_FPS=60
# Buffer genuine decoded frames to absorb brief USB/ffmpeg scheduling stalls.
WUJI_VR_EGO_QUEUE_DEPTH=12
WUJI_VR_EGO_SOURCE="PICO native VST stereo CameraHandle H.264 stream (Tracker UI independent)"

# Third-person Gemini 2 RGB.
WUJI_MAIN_TOPIC=/gemini2/color/image_raw
WUJI_GEMINI_DEVICE=auto
# Use the local V4L2 MJPEG publisher for the 60 Hz RGB stream.  The official
# Orbbec ROS driver currently exposes only 30 Hz color profiles on this device.
WUJI_GEMINI_TOPIC=/gemini2/color/image_raw/compressed
WUJI_GEMINI_IMU_TOPIC=/gemini2/gyro_accel/sample
# Keep this disabled while using the V4L2 publisher; the official driver and
# V4L2 publisher cannot own the same USB camera at the same time.
WUJI_GEMINI_IMU_ENABLED=0
WUJI_GEMINI_ORBBEC_INSTALL=.runtime/orbbec/install
# Lower resolution keeps the requested 60 Hz profile within USB/V4L2 limits.
WUJI_GEMINI_RGB_WIDTH=640
WUJI_GEMINI_RGB_HEIGHT=480
WUJI_GEMINI_RGB_FPS=60

# PICO Tracker PoseStamped streams.  The dual publisher maps these serials to
# the camera mount and right wrist respectively. XRoboToolkit is polled at
# 90 Hz; only a new Motion.timeStampNs sample is published. Cached SDK reads
# are suppressed so polling frequency cannot masquerade as Tracker frequency.
WUJI_TRACKER_ENABLED=1
WUJI_TRACKER_CAMERA_SERIAL=PC2310MLKC190573G
WUJI_TRACKER_WRIST_SERIAL=PC2310MLKC190056G
WUJI_TRACKER_CAMERA_TOPIC=/pico/right_upper_arm/raw_pose
WUJI_TRACKER_WRIST_TOPIC=/pico/right_wrist/raw_pose
WUJI_TRACKER_CAMERA_Z_OFFSET_M=0.10
WUJI_TRACKER_PUBLISH_RATE_HZ=90.0
# Optional ROS overlay containing the pico_input package. Leave empty when
# pico_input is already available in the shell's ROS environment.
WUJI_PICO_SETUP_BASH=
# Fallback for the standard teleop deployment where pico_input is inside the
# wuji-hand-teleop container rather than installed on the host.
WUJI_PICO_DOCKER_ENABLED=1
WUJI_PICO_DOCKER_AUTOSTART=1
WUJI_PICO_CONTAINER=wuji-hand-teleop
WUJI_PICO_CONTAINER_SETUP=/home/wuji/ros2_ws/install/setup.bash
# Historical 76-89 Hz native streams have a worst measured 41.7 ms source gap,
# so 25 ms covers the closest real sample with margin. Rows beyond 25 ms are
# never retained; only a small audited sparse-row drop may salvage an episode.
WUJI_MAX_TRACKER_AGE_MS=25

# Original Myo armband through the Bluegiga BLED112 receiver.
WUJI_MYO_ENABLED=1
WUJI_MYO_TTY=/dev/serial/by-id/usb-Bluegiga_Low_Energy_Dongle_1-if00
WUJI_MYO_MAC=auto
WUJI_MYO_MIN_HZ=180
WUJI_MYO_SILENCE_TIMEOUT_S=0.35

# Additional Wavletech armband through its USB serial receiver. Prefer a stable
# /dev/serial/by-id path in config/local.env after the receiver is inserted.
WUJI_WAVLETECH_ENABLED=1
WUJI_WAVLETECH_TTY=/dev/ttyUSB0
WUJI_WAVLETECH_BAUD=921600
# This receiver was measured at 2000 native AA EMG samples/s. Require at least
# 1950 Hz so USB scheduling jitter cannot masquerade as a lower-rate capture.
WUJI_WAVLETECH_EXPECTED_HZ=2000
WUJI_WAVLETECH_MIN_HZ=1950

# Quality gates. These fail closed: an invalid episode is not written.
# Allow normal ROS scheduling jitter while still rejecting stale glove frames.
WUJI_MAX_GLOVE_AGE_MS=10
# Allow short whole-SDK pauses to recover. Uncovered canonical rows are removed
# at save; the 5% alignment-drop budget still bounds total data loss.
WUJI_MAX_SOURCE_GAP_MS=500
WUJI_MAX_WRIST_POSE_AGE_MS=15
WUJI_MAX_GEMINI_AGE_MS=10
WUJI_MAX_CAMERA_POSE_AGE_MS=20
WUJI_MAX_RGB_GAP_MS=50
WUJI_MAX_RGB_MISSING_RATIO=0.03
WUJI_MAX_JOINT_STEP_RAD=2.5
# Myo alignment and BLE continuity gates (legacy FTP-1 EMG field).
WUJI_MAX_EMG_AGE_MS=100
WUJI_MAX_EMG_MISSING_RATIO=0.02
WUJI_MAX_EMG_GAP_MS=350
# Wavletech serial may deliver samples in transport batches; keep its gates
# independent from Myo so either link can be diagnosed without ambiguity.
WUJI_MAX_WAVLETECH_EMG_AGE_MS=100
WUJI_MAX_WAVLETECH_EMG_MISSING_RATIO=0.02
WUJI_MAX_WAVLETECH_EMG_GAP_MS=350
WUJI_WAVLETECH_SILENCE_TIMEOUT_S=0.35
WUJI_MIN_EGO_SHARPNESS=70
